rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Auth: phone+PIN verified by the loginUserWithPin Cloud Function, which issues
    // a Firebase Custom Token embedding role, workplace, and specialty claims.
    // All Firestore rules below rely on that token (request.auth / request.auth.token).

    match /users/{userId} {
      allow read: if true;           // needed for phone+PIN login lookup
      allow write: if true;          // needed for FCM token, location, lastActive updates
    }

    match /emergencyCases/{caseId} {
      // Role-based confidentiality at the document level.
      // - VHT: only their own cases (resource.data.vhtId == request.auth.uid)
      // - Clinic Staff: only cases assigned to their facility (assignedClinicName == token.workplace)
      // - Ambulance Driver: only cases assigned to them (assignedAmbulanceId == request.auth.uid)
      // - Admin: can read all cases
      allow read: if request.auth != null && (
        request.auth.token.role == "Admin" ||
        (request.auth.token.role == "VHT" && resource.data.vhtId == request.auth.uid) ||
        (
          request.auth.token.role == "Clinic Staff" &&
          resource.data.assignedClinicName == request.auth.token.workplace
        ) ||
        (
          request.auth.token.role == "Ambulance Driver" &&
          resource.data.assignedAmbulanceId == request.auth.uid
        )
      );
      allow write: if true;
    }

    match /emergencyCases/{caseId}/followUps/{followUpId} {
      allow read, write: if true;    // VHT follow-up updates
    }

    // Clinician private notes (dispatch path notes)
    // Stored in a subcollection so Firestore rules can prevent VHT access.
    match /emergencyCases/{caseId}/clinicianPrivateNotes/{noteId} {
      allow read, write: if request.auth != null && (
        request.auth.token.role == "Admin" ||
        (
          request.auth.token.role == "Clinic Staff" &&
          get(/databases/$(database)/documents/emergencyCases/$(caseId)).data.assignedClinicName == request.auth.token.workplace
        )
      );
    }

    // Treatment records written when a patient is discharged by the clinician.
    match /emergencyCases/{caseId}/treatments/{treatmentId} {
      allow read, write: if request.auth != null && (
        request.auth.token.role == "Admin" ||
        request.auth.token.role == "Clinic Staff"
      );
    }

    match /notifications/{notifId} {
      allow read, write: if true;    // needed for notification bell and in-app notifications
    }
  }
}
