rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read user data (for finding users by phone)
      allow read: if true;
      
      // Only the user can update their own profile
      allow update: if isOwner(userId);
      
      // Anyone can create a user (for registration)
      allow create: if true;
      
      // Only the user can delete their own account
      allow delete: if isOwner(userId);
    }
    
    // Emergency cases collection (to be added later)
    match /emergencyCases/{caseId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
    
    // Children/Immunization records (to be added later)
    match /children/{childId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
    
    // Ambulances (to be added later)
    match /ambulances/{ambulanceId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}
